{
  "name": "verifaktura-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare:sef": "node scripts/build-sef.mjs",
    "build": "npm run build -w verifaktura && npm run build -w @verifaktura/build && npm run build -w @verifaktura/cius-hr && npm run build -w @verifaktura/cli",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:core": "npm run build -w verifaktura",
    "verify:artefacts": "node scripts/verify-artefacts.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "build:web": "node web/scripts/build.mjs",
    "check:web": "node web/scripts/check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "xslt3": "^2.7.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "saxon-js": "^2.7.0"
  }
}
